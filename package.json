{
  "name": "ng-anti-slop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Opinionated ESLint, TypeScript and Prettier setup for Angular 18+, based on extreme-angular.",
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm typecheck:plugin && pnpm check:skill-assets",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\"",
    "typecheck:plugin": "tsc --noEmit -p tsconfig.plugin.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sync:skill-assets": "node scripts/sync-skill-assets.mjs",
    "check:skill-assets": "node scripts/sync-skill-assets.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.0",
    "@typescript-eslint/utils": "8.71.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT"
}
